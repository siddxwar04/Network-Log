# Copy this file to .env and fill in what you need. Never commit .env.
# The tool reads .env from the folder it is run in.

# Where the local database file is stored (phase 1.4).
NETLOG_DB_PATH=data/netlog.db

# LLM provider for incident explanations. Supported: openai
# Leave the provider empty to run without an LLM.
NETLOG_LLM_PROVIDER=
# Empty uses the provider's default model.
NETLOG_LLM_MODEL=
# Your API key. Keep it in .env only: never in a settings file, never in git.
NETLOG_LLM_API_KEY=
