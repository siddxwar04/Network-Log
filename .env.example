# Copy this file to .env and fill in what you need. Never commit .env.
# Nothing here is used yet; the settings are listed so later phases have one place to look.

# Where the local database file is stored (phase 1.4).
NETLOG_DB_PATH=data/netlog.db

# LLM provider for incident explanations (phase 3.2).
# Leave empty to run without an LLM: the tool then uses its built-in fallback explanations.
NETLOG_LLM_PROVIDER=
NETLOG_LLM_MODEL=
NETLOG_LLM_API_KEY=
