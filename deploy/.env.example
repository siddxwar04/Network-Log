# netlog settings for the Docker install. Copy this file to .env in this folder and change
# what you need; .env is ignored by git. Every value below is the default, so a missing
# .env, or a line left out, gives the same result.
#
# After changing anything:   docker compose up -d
#
# Values are written without quotes. A list is written in square brackets with each item
# in double quotes: ["R1", "CORE-SW1"]. Never put a $ sign in a value.

# --- Where the app can be reached ----------------------------------------------------------

# The web interface (and the API behind it) is published on this address and port of the
# host. There is NO LOGIN: anyone who can reach this address can read every log you load,
# change the rules and delete uploads. 127.0.0.1 means this computer only. Use 0.0.0.0, or
# one network card's address, only on a network where everyone may see your logs.
NETLOG_WEB_BIND=127.0.0.1
NETLOG_WEB_PORT=8080

# The live syslog listener, UDP and TCP. Syslog has no authentication: anyone who can reach
# this port can send messages that look like they come from your routers. 127.0.0.1 accepts
# messages from this computer only. To receive from devices, set the address of the host's
# network card they can reach (not 0.0.0.0), and list them in NETLOG__LIVE__ALLOWED_SENDERS.
NETLOG_SYSLOG_BIND=127.0.0.1
NETLOG_SYSLOG_PORT=5514

# Run the live listener at all: 1 on, 0 off.
NETLOG_LIVE=1

# --- LLM for the explanations (optional) ---------------------------------------------------

# Leave the provider empty for demo mode: the demo scenarios show explanations stored with
# them, any other file gets the built-in explanation. Nothing leaves this machine.
# Supported provider: openai
NETLOG_LLM_PROVIDER=
# Empty uses the provider's default model.
NETLOG_LLM_MODEL=
# Your API key. It stays in this file and the container's environment only.
NETLOG_LLM_API_KEY=

# Replace addresses, device names, usernames and MAC addresses with stand-ins before an
# evidence pack is sent to the LLM. Turn off only for a model that runs on your own machine.
NETLOG__REDACTION__ENABLED=true

# --- Alerts from the live listener (optional) ----------------------------------------------

# Leave both empty for no alerts. A webhook address is a secret: whoever has it can post
# to your channel.
# A Slack incoming webhook, or anything that takes Slack's format.
NETLOG_ALERT_SLACK_URL=
# Any other receiver: the alert is posted as plain JSON.
NETLOG_ALERT_WEBHOOK_URL=
# Lowest severity that raises an alert: info, low, medium, high or critical.
NETLOG__ALERTS__MIN_SEVERITY=high
# Also say when an alerted incident has closed.
NETLOG__ALERTS__ON_CLOSE=false
# Replace IP addresses and usernames in alert text with [IP] and [user]. Turn on when the
# chat service is not your own (Slack, Discord).
NETLOG__ALERTS__REDACT=false
# The link in each alert. Empty means http://localhost: and NETLOG_WEB_PORT. Set an address
# your phone can reach if you want the link to open there.
NETLOG__ALERTS__LINK_BASE=

# --- Live listener ---------------------------------------------------------------------------

# Only these sender addresses are accepted; [] accepts any sender that can reach the port.
# Docker Desktop (Windows, macOS) can show every sender as one internal address, so this
# list only works on a Linux host. See docs/INSTALL.md.
NETLOG__LIVE__ALLOWED_SENDERS=[]
# The timezone of the devices' clocks, for messages that do not say: UTC or an offset
# such as +05:30.
NETLOG__LIVE__TIMEZONE=UTC
# How many days messages are kept. Incidents and their evidence are kept longer.
NETLOG__LIVE__RETENTION_EVENTS_DAYS=7
NETLOG__LIVE__RETENTION_INCIDENTS_DAYS=90

# --- Detection -------------------------------------------------------------------------------

# Devices that matter most. A finding on one of them is raised one severity level.
NETLOG__SEVERITY__CRITICAL_DEVICES=[]

# --- Uploads ---------------------------------------------------------------------------------

# The largest file that may be uploaded, in megabytes. The web server in front accepts up
# to 100; to go higher, also raise client_max_body_size in deploy/nginx.conf.
NETLOG__API__MAX_UPLOAD_MB=50

# --- Any other setting -----------------------------------------------------------------------

# Every setting in backend/netlog/config/defaults.toml can be set here the same way:
# NETLOG__ then the section, two underscores, then the setting, in capitals. For example
# gap_seconds in [correlation]:
#   NETLOG__CORRELATION__GAP_SECONDS=60
# A name that is not a setting, or a value of the wrong kind, stops the app at start with
# a message naming it: read it with  docker compose logs backend
